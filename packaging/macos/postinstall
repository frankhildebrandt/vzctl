#!/bin/sh
# Payload replacement follows successful preinstall. Configure and start only.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
. "$script_dir/installer-common.sh"
[ "${3:-/}" = / ] || fail "installation is supported only on the current startup volume"
resolve_console_user
if [ -z "$console_user" ]; then
  echo "postinstall: no console user; payload installed, LaunchAgents require a logged-in user" >&2
  exit 0
fi

bindir=/usr/local/bin
libexec=/usr/local/libexec/vzctl
launch_agents_dir="$console_home/Library/LaunchAgents"
log_dir="$console_home/Library/Logs/vzctl"
user_apps="$console_home/Applications"
state_dir="$console_home/Library/Application Support/vzctl"
agent_path="${bindir}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# User-controlled runtime paths must never turn symlinks into privileged writes.
# The package payload is installed by Installer; per-user files use the user's UID.
user_run() { sudo -u "$console_user" -- "$@"; }

for binary in vzctl vzctl-mcp vzctl-oidc-simple vz-net vz-edge vz-supervisor vz-helper vz-dns-bind; do
  [ -x "$bindir/$binary" ] || fail "missing installed executable $binary"
done
for binary in caddy dex qemu-img; do
  [ -x "$libexec/$binary/$binary" ] || fail "missing installed runtime dependency $binary"
done
user_run mkdir -p "$launch_agents_dir" "$log_dir" "$user_apps" "$state_dir/bin" "$state_dir/libexec"
user_run chmod 700 "$log_dir" "$state_dir"

user_run ditto /Applications/vzctl.app "$user_apps/vzctl.app"
user_run install -m 0755 "$libexec/caddy/caddy" "$state_dir/bin/caddy"
user_run install -m 0755 "$libexec/dex/dex" "$state_dir/bin/dex"
user_run install -m 0755 "$bindir/vzctl-oidc-simple" "$state_dir/bin/vzctl-oidc-simple"
user_run ditto "$libexec/qemu-img" "$state_dir/libexec/qemu-img"

write_agent_plist() {
  service=$1
  plist="$launch_agents_dir/com.vzctl.$service.plist"
  staged_plist=$(user_run mktemp "$launch_agents_dir/.vzctl-$service.XXXXXX")
  user_run plutil -create xml1 "$staged_plist"
  user_run plutil -insert Label -string "com.vzctl.$service" "$staged_plist"
  user_run plutil -insert ProgramArguments -array "$staged_plist"
  user_run plutil -insert ProgramArguments.0 -string "$bindir/vz-$service" "$staged_plist"
  user_run plutil -insert ProgramArguments.1 -string serve "$staged_plist"
  user_run plutil -insert RunAtLoad -bool true "$staged_plist"
  user_run plutil -insert KeepAlive -bool true "$staged_plist"
  user_run plutil -insert ProcessType -string Background "$staged_plist"
  user_run plutil -insert EnvironmentVariables -dictionary "$staged_plist"
  user_run plutil -insert EnvironmentVariables.PATH -string "$agent_path" "$staged_plist"
  user_run plutil -insert StandardOutPath -string "$log_dir/$service.log" "$staged_plist"
  user_run plutil -insert StandardErrorPath -string "$log_dir/$service.error.log" "$staged_plist"
  user_run plutil -lint "$staged_plist"
  user_run chmod 0644 "$staged_plist"
  user_run mv -f "$staged_plist" "$plist"
}
for service in net edge supervisor; do write_agent_plist "$service"; done

# Preinstall proved all old owners stopped; remove only leftover socket entries.
for socket in net.sock edge.sock vz.sock api.sock; do
  if [ -S "$state_dir/$socket" ]; then user_run rm -f "$state_dir/$socket"; fi
done
for service in net edge supervisor; do
  label="com.vzctl.$service"
  launchctl bootstrap "$domain" "$launch_agents_dir/$label.plist"
  launchctl kickstart "$domain/$label"
  launchctl print "$domain/$label" >/dev/null
  case "$service" in supervisor) wait_sock "$state_dir/vz.sock" ;; *) wait_sock "$state_dir/$service.sock" ;; esac
done
wait_sock "$state_dir/api.sock"
echo "postinstall: started net → edge → supervisor for $console_user"
echo "postinstall: guest DNS :53 → sudo vzctl dns install-bind-helper"
