#cloud-config
hostname: router
manage_etc_hosts: true
users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: "ubuntu"
ssh_pwauth: true
package_update: false
runcmd:
  - sysctl -w net.ipv4.ip_forward=1
  - iptables -P FORWARD ACCEPT || true
