[Unit]
Description=vzctl virtio-vsock guest agent
Documentation=https://github.com/frankhildebrandt/vzctl/blob/main/docs/specs/guest-agent-v1.md
# Token comes from cloud-init write_files (cloud-config), not cloud-final.
# After=cloud-final + WantedBy=multi-user creates an ordering cycle and
# systemd deletes the start job.
After=cloud-config.service
Wants=cloud-config.service
ConditionPathIsReadWrite=/run
ConditionFileNotEmpty=/var/lib/vzctl/agent.token

[Service]
Type=simple
User=vzctl-agent
Group=vzctl-agent
UMask=0077
ExecStart=/usr/local/sbin/vzctl-agent --port 21950 --token-file /var/lib/vzctl/agent.token
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_SYS_TIME
PrivateTmp=yes
ProtectClock=no
# Interactive `vm exec` and sudo -n helpers (virtiofs-bind, router-apply,
# update-ca-certificates) need privilege escalation. systemd.exec: many
# sandbox flags force no_new_privs (and ignore NoNewPrivileges=no) —
# PrivateDevices, ProtectKernelTunables, ProtectHostname, LockPersonality,
# MemoryDenyWriteExecute, RestrictRealtime, RestrictAddressFamilies,
# RestrictSUIDSGID. ProtectSystem=strict also leaves sudo root in a
# read-only mount namespace. CapabilityBoundingSet must stay unrestricted
# so setuid sudo-rs can restore uids and nft can use CAP_NET_ADMIN.
NoNewPrivileges=no
RestrictSUIDSGID=no

[Install]
WantedBy=multi-user.target
