[Unit]
Description=vzctl virtio-vsock guest agent
Documentation=https://github.com/frankhildebrandt/vzctl/blob/main/docs/specs/guest-agent-v1.md
Wants=cloud-final.service
After=cloud-final.service
ConditionPathIsReadWrite=/run
ConditionPathIsRegular=/run/vzctl/agent.token

[Service]
Type=simple
User=vzctl-agent
Group=vzctl-agent
UMask=0077
ExecStart=/usr/local/sbin/vzctl-agent --port 21950 --token-file /run/vzctl/agent.token
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME
AmbientCapabilities=CAP_SYS_TIME
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=no
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_VSOCK

[Install]
WantedBy=multi-user.target
