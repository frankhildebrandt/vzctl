[Unit]
Description=vzctl virtio-vsock guest agent
Documentation=https://github.com/frankhildebrandt/vzctl/blob/main/docs/specs/guest-agent-v1.md
# Token comes from cloud-init write_files (cloud-config), not cloud-final.
# After=cloud-final + WantedBy=multi-user creates an ordering cycle and
# systemd deletes the start job.
After=cloud-config.service
Wants=cloud-config.service
ConditionPathIsReadWrite=/run
ConditionFileNotEmpty=/var/lib/vzctl/agent.token

[Service]
Type=simple
User=vzctl-agent
Group=vzctl-agent
UMask=0077
ExecStart=/usr/local/sbin/vzctl-agent --port 21950 --token-file /var/lib/vzctl/agent.token
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME
AmbientCapabilities=CAP_SYS_TIME
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=no
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_VSOCK

[Install]
WantedBy=multi-user.target
