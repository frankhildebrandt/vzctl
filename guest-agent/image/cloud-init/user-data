#cloud-config
# Render the placeholders per VM. This seed configures identity and credentials;
# vzctl-agent is already installed in the sealed base.
preserve_hostname: false
hostname: __HOSTNAME__
fqdn: __FQDN__
prefer_fqdn_over_hostname: true
manage_etc_hosts: true
ssh_deletekeys: true
ssh_genkeytypes:
  - ed25519
  - rsa
ssh_authorized_keys:
  - __SSH_PUBLIC_KEY__
write_files:
  - path: /run/vzctl/agent.token
    owner: vzctl-agent:vzctl-agent
    permissions: "0600"
    content: |
      __BASE64URL_256_BIT_TOKEN__
